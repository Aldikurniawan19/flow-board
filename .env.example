# Supabase PostgreSQL Transaction Pooler URI (Port 6543 — recommended for Vercel Serverless)
# Replace [YOUR-DATABASE-PASSWORD] with your actual Supabase database password.
# NEVER commit real passwords to Git!
DATABASE_URL=postgresql://postgres.whjpicguieogzkmuslot:[YOUR-DATABASE-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Automatically enabled on Vercel HTTPS; set true in production HTTPS environments
COOKIE_SECURE=true

# Google OAuth 2.0 (Sign in with Google — create Web Application credentials in Google Cloud Console)
# Authorized redirect URI: https://flow-board-dun.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
