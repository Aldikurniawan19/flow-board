{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/types/env.d.ts", "src/**/*.js", "src/**/*.jsx", "server/**/*.js", "api/**/*.js"],
  "exclude": ["node_modules", "dist", "data"]
}
